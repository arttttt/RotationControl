<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="RotationControl.Widget.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="elevation">0dp</item>
        <item name="materialThemeOverlay">@style/RotationControl.ThemeOverlay.BottomNavigationView</item>
    </style>

    <style name="RotationControl.Widget.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/colorSecondary</item>
    </style>

    <style name="RotationControl.Widget.FloatingActionButton" parent="Theme.RotationControl">
        <item name="backgroundTint">@color/colorSecondary</item>
    </style>

    <style name="RotationControl.Widget.Switch" parent="Theme.RotationControl">
        <item name="colorControlActivated">@color/colorSecondary</item>
    </style>

    <style name="RotationControl.Widget.AppBar" parent="Widget.MaterialComponents.AppBarLayout.Surface">
        <item name="android:background">@android:color/white</item>
    </style>

</resources>